# Settings for the pedagogue daemon and the tour launcher.
# Copy to ~/.config/pedagogue/env and chmod 600. Variables set in the shell win.

# Required. The key every tutor runs on.
ANTHROPIC_API_KEY=

# Addresses to listen on. Add this machine's tailnet address to use tours from
# another machine.
#PEDAGOGUE_HOST=127.0.0.1,100.x.y.z

# Base URL for the links handed out for tours.
#PEDAGOGUE_PUBLIC_URL=http://desk.your-tailnet.ts.net:4270

#PEDAGOGUE_PORT=4270
#PEDAGOGUE_DATA_DIR=
#PEDAGOGUE_IDLE_MINUTES=15
#PEDAGOGUE_MODEL=

# Where the launcher finds the daemon.
#PEDAGOGUE_URL=http://127.0.0.1:4270
