# Settings for the pedagogue daemon and the walkthrough launcher.
# Copy to ~/.config/pedagogue/env and chmod 600. Variables set in the shell win.

# Required: exactly one of these two. What every tutor runs on.
# An Anthropic API key, billed per token:
ANTHROPIC_API_KEY=
# Or a Claude subscription token for your own account, from `claude setup-token`:
#CLAUDE_CODE_OAUTH_TOKEN=

# Addresses to listen on. Add this machine's tailnet address to use walkthroughs from
# another machine.
#PEDAGOGUE_HOST=127.0.0.1,100.x.y.z

# Base URL for the links handed out for walkthroughs.
#PEDAGOGUE_PUBLIC_URL=http://desk.your-tailnet.ts.net:4270

#PEDAGOGUE_PORT=4270
#PEDAGOGUE_DATA_DIR=
#PEDAGOGUE_IDLE_MINUTES=15
#PEDAGOGUE_MODEL=

# Where the launcher finds the daemon.
#PEDAGOGUE_URL=http://127.0.0.1:4270
