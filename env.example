# Settings for the pedagogy daemon and the tour launcher.
# Copy to ~/.config/pedagogy/env and chmod 600. Variables set in the shell win.

# Required. The key every tutor runs on.
ANTHROPIC_API_KEY=

# Addresses to listen on. Add this machine's tailnet address to use tours from
# another machine.
#PEDAGOGY_HOST=127.0.0.1,100.x.y.z

# Base URL for the links handed out for tours.
#PEDAGOGY_PUBLIC_URL=http://desk.your-tailnet.ts.net:4270

#PEDAGOGY_PORT=4270
#PEDAGOGY_DATA_DIR=
#PEDAGOGY_IDLE_MINUTES=15
#PEDAGOGY_MODEL=

# Where the launcher finds the daemon.
#PEDAGOGY_URL=http://127.0.0.1:4270
