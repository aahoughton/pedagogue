		"ws": "^8.22.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"typescript": "^7.0.2"
	}
}
